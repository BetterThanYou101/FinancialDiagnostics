<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DSO__c</fullName>
    <label>DSO</label>
    <formula>IF(Total_Invoiced__c = 0, 0, Total_Outstanding__c / Total_Invoiced__c * Days_In_Period__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Number</type>
</CustomField>
