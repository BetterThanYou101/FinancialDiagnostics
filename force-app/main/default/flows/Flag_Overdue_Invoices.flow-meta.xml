<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Overdue</name>
        <label>Is Overdue</label>
        <defaultConnector>
            <targetReference>end_of_loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Overdue_Invoice</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_Overdue_Invoices.Days_Overdue__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Overdue</targetReference>
            </connector>
            <label>Yes - mark overdue</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Flag Overdue Invoices {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flag Overdue Invoices</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_open_invoices</name>
        <label>Get open invoices</label>
        <filters>
            <field>Invoice_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <filters>
            <field>Invoice_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </filters>
        <filters>
            <field>Invoice_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Void</stringValue>
            </value>
        </filters>
        <filters>
            <field>Invoice_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Overdue</stringValue>
            </value>
        </filters>
        <object>Invoice__c</object>
        <outputCollection>get_open_invoices</outputCollection>
        <outputReference>get_open_invoices</outputReference>
    </recordLookups>
    <recordUpdates>
        <name>Mark_Overdue</name>
        <label>Mark Overdue</label>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>loop_Overdue_Invoices.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Invoice_Status__c</field>
            <value>
                <stringValue>Overdue</stringValue>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordUpdates>
    <start>
        <object>Invoice__c</object>
        <triggerType>Scheduled</triggerType>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-24</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
    </start>
    <status>Active</status>
    <variables>
        <name>get_open_invoices</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Invoice__c</objectType>
    </variables>
</Flow>
